# SQLite is the authoritative application database. A local file is the
# zero-configuration default; libsql:// URLs may supply SQLITE_AUTH_TOKEN.
SQLITE_DATABASE_URL=file:./data/byok-grid.sqlite
SQLITE_AUTH_TOKEN=

# Apply migrations once before starting web/worker replicas:
# npm run db:migrate

# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
BYOK_GRID_MASTER_KEY=
BYOK_GRID_MASTER_KEY_ID=local-v1

# Optional signed, digest-pinned community connector runner. Keep this disabled
# unless an administrator has reviewed the publisher key, manifest, and artifact
# digest. In Compose, generate the shared secret with `openssl rand -base64 32`
# and set:
# BYOK_GRID_CONNECTOR_REGISTRY_PATH=/connectors/registry.json
# CONNECTOR_REGISTRY_HOST_PATH=./examples/connectors/reference
# CONNECTOR_RUNNER_URL=http://connector-runner:4319
BYOK_GRID_CONNECTOR_REGISTRY_PATH=
BYOK_GRID_CONNECTOR_REGISTRY_SIGNATURE_PATH=
BYOK_GRID_CONNECTOR_TRUST_KEYS={"byok_grid_reference_2026":"d30d04cc80d66bff277650ce03561ed543a321921199f48de5c20355bb213e86"}
BYOK_GRID_ALLOW_UNSIGNED_CONNECTOR_REGISTRY=false
CONNECTOR_REGISTRY_HOST_PATH=
CONNECTOR_RUNNER_REGISTRY_SIGNATURE_PATH=
CONNECTOR_RUNNER_TRUST_KEYS={"byok_grid_reference_2026":"d30d04cc80d66bff277650ce03561ed543a321921199f48de5c20355bb213e86"}
CONNECTOR_RUNNER_ALLOW_UNSIGNED_REGISTRY=false
CONNECTOR_RUNNER_SHARED_SECRET=
CONNECTOR_RUNNER_URL=

# Hatchet's auth-disabled local image prints this token at startup and exposes it
# in Settings -> API Tokens. Never commit a real production token.
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_HOST_PORT=localhost:7077
HATCHET_CLIENT_TLS_STRATEGY=none
WORKFLOW_DISPATCH_POLL_MS=1000
SOURCE_SCHEDULER_POLL_SECONDS=30

# Server-enforced bulk enrichment guardrails. These are worst-case request and
# OpenAI output-token ceilings per confirmed batch, not billing estimates.
BULK_RUN_MAX_ROWS=500
BULK_RUN_MAX_PROVIDER_REQUESTS=1000
BULK_RUN_MAX_OUTPUT_TOKENS=500000
AUTOMATIC_RUN_MAX_PER_ROW_CHANGE=10
AUTOMATIC_WRITEBACK_MAX_PER_ROW_CHANGE=5

# Optional ClickHouse event projection. The default application does not read
# these values. Enable it only with `docker compose --profile analytics up`.
# Production must use a secret manager and an HTTPS ClickHouse endpoint.
ANALYTICS_PROJECTION_BATCH_SIZE=100
ANALYTICS_PROJECTION_LEASE_SECONDS=300
ANALYTICS_PROJECTION_POLL_SECONDS=2
CLICKHOUSE_ALLOW_INSECURE_HTTP=false
CLICKHOUSE_DATABASE=byok_grid_analytics
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TABLE=events
CLICKHOUSE_URL=https://clickhouse.example.com
CLICKHOUSE_USERNAME=projector

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth signs cookies with this secret and serves from this canonical URL.
# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
