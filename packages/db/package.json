{
  "name": "@byok-grid/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/sqlite/index.ts",
    "./postgres": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./sqlite/schema": "./src/sqlite/schema.ts"
  },
  "scripts": {
    "benchmark:grid": "vitest bench src/grid.bench.ts --run",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:sqlite:generate": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:sqlite:migrate": "tsx src/sqlite/migrate-cli.ts",
    "db:migrate": "tsx src/migrate.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@byok-grid/domain": "*",
    "@byok-grid/security": "*",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "postgres": "3.4.9",
    "tsx": "4.23.1"
  }
}
