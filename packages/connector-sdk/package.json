{
  "name": "@byok-grid/connector-sdk",
  "version": "0.2.0",
  "description": "Versioned connector protocol for BYOK Grid providers.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
