{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "app",
    "secrets",
    "web",
    "worker",
    "migration",
    "connectorRunner",
    "analyticsProjector"
  ],
  "properties": {
    "app": {
      "type": "object",
      "required": ["publicUrl"],
      "additionalProperties": false,
      "properties": {
        "publicUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret", "create", "values", "keys"],
      "properties": {
        "existingSecret": { "type": "string" },
        "create": { "type": "boolean" },
        "values": {
          "type": "object",
          "properties": {
            "sqliteDatabaseUrl": { "type": "string" },
            "sqliteAuthToken": { "type": "string" },
            "masterKey": { "type": "string" },
            "additionalMasterKeys": { "type": "string" },
            "hatchetClientToken": { "type": "string" },
            "connectorRunnerSharedSecret": { "type": "string" },
            "clickhousePassword": { "type": "string" }
          }
        },
        "keys": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "create": { "const": false } } },
          "then": { "properties": { "existingSecret": { "minLength": 1 } } }
        },
        {
          "if": { "properties": { "create": { "const": true } } },
          "then": {
            "properties": {
              "values": {
                "required": [
                  "sqliteDatabaseUrl",
                  "masterKey",
                  "hatchetClientToken"
                ],
                "properties": {
                  "sqliteDatabaseUrl": {
                    "minLength": 1,
                    "pattern": "^libsql://"
                  },
                  "masterKey": { "minLength": 1 },
                  "hatchetClientToken": { "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "web": {
      "allOf": [
        { "$ref": "#/definitions/workload" },
        {
          "type": "object",
          "required": ["terminationGracePeriodSeconds", "preStopSleepSeconds"],
          "properties": {
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 15,
              "maximum": 300
            },
            "preStopSleepSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            }
          }
        }
      ]
    },
    "worker": {
      "allOf": [
        { "$ref": "#/definitions/workload" },
        {
          "type": "object",
          "required": [
            "terminationGracePeriodSeconds",
            "hatchet",
            "health",
            "metrics"
          ],
          "properties": {
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 600
            },
            "hatchet": {
              "type": "object",
              "required": ["apiUrl", "hostPort", "tlsStrategy"],
              "properties": {
                "apiUrl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "hostPort": { "type": "string", "minLength": 1 },
                "tlsStrategy": { "const": "tls" }
              }
            },
            "health": {
              "type": "object",
              "required": ["port"],
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                }
              }
            },
            "metrics": {
              "type": "object",
              "required": ["enabled", "port"],
              "properties": {
                "enabled": { "type": "boolean" },
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                }
              }
            }
          }
        }
      ]
    },
    "migration": { "$ref": "#/definitions/imageWorkload" },
    "connectorRunner": {
      "allOf": [
        { "$ref": "#/definitions/imageWorkload" },
        {
          "type": "object",
          "required": [
            "enabled",
            "existingClaim",
            "allowUnsignedRegistry",
            "terminationGracePeriodSeconds",
            "preStopSleepSeconds"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "allowUnsignedRegistry": { "const": false },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 15,
              "maximum": 300
            },
            "preStopSleepSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            }
          },
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "existingClaim": { "minLength": 1 } } }
        }
      ]
    },
    "analyticsProjector": {
      "allOf": [
        { "$ref": "#/definitions/workload" },
        {
          "type": "object",
          "required": ["enabled", "terminationGracePeriodSeconds", "health"],
          "properties": {
            "enabled": { "type": "boolean" },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 15,
              "maximum": 300
            },
            "health": {
              "type": "object",
              "required": ["port"],
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                }
              }
            },
            "clickhouse": {
              "type": "object",
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "allowInsecureHttp": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "ingress": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingress", "egress"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "required": ["web", "monitoring"],
          "additionalProperties": false,
          "properties": {
            "web": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyPeer" }
            },
            "monitoring": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyPeer" }
            }
          }
        },
        "egress": {
          "type": "object",
          "required": [
            "enabled",
            "shared",
            "web",
            "worker",
            "analyticsProjector"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "shared": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyEgressRule" }
            },
            "web": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyEgressRule" }
            },
            "worker": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyEgressRule" }
            },
            "analyticsProjector": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyEgressRule" }
            }
          }
        }
      }
    },
    "serviceAccount": { "type": "object" },
    "imagePullSecrets": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy", "tag", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        }
      },
      "not": {
        "required": ["tag", "digest"],
        "properties": {
          "tag": { "minLength": 1 },
          "digest": { "minLength": 1 }
        }
      }
    },
    "imageWorkload": {
      "type": "object",
      "required": ["image"],
      "properties": { "image": { "$ref": "#/definitions/image" } }
    },
    "workload": {
      "allOf": [
        { "$ref": "#/definitions/imageWorkload" },
        {
          "type": "object",
          "required": ["replicaCount", "resources"],
          "properties": {
            "replicaCount": { "type": "integer", "minimum": 1 },
            "resources": { "type": "object" }
          }
        }
      ]
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "operator"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": {
                "enum": ["In", "NotIn", "Exists", "DoesNotExist"]
              },
              "values": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podSelector": { "$ref": "#/definitions/labelSelector" },
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "ipBlock": {
          "type": "object",
          "required": ["cidr"],
          "additionalProperties": false,
          "properties": {
            "cidr": { "type": "string", "minLength": 1 },
            "except": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["ipBlock"],
          "not": {
            "anyOf": [
              { "required": ["podSelector"] },
              { "required": ["namespaceSelector"] }
            ]
          }
        },
        {
          "not": { "required": ["ipBlock"] },
          "anyOf": [
            { "required": ["podSelector"] },
            { "required": ["namespaceSelector"] }
          ]
        }
      ]
    },
    "networkPolicyPort": {
      "type": "object",
      "required": ["port"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "enum": ["TCP", "UDP", "SCTP"] },
        "port": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "minLength": 1 }
          ]
        },
        "endPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "networkPolicyEgressRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/networkPolicyPeer" }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/networkPolicyPort" }
        }
      },
      "anyOf": [{ "required": ["to"] }, { "required": ["ports"] }]
    }
  }
}
